meta {
  name: get_research
  type: http
  seq: 5
}

get {
  url: http://127.0.0.1:5000/api/researches/:research_id
  body: none
  auth: none
}

params:path {
  research_id: 1
}

tests {
  test("should return status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("should return JSON object with correct keys", function() {
    const body = res.getBody();
    
    expect(body).to.be.an('object');
    expect(body).to.have.all.keys('data', 'message', 'success');
  });
  
  test("should have success set to true", function() {
    const body = res.getBody();
    
    expect(body.success).to.be.true;
  });
  
  test("should have message 'Onderzoek gevonden'", function() {
    const body = res.getBody();
    
    expect(body.message).to.equal("Onderzoek gevonden");
  });
  
  test("should return data as an object with correct keys", function() {
    const body = res.getBody();
    
    expect(body.data).to.be.an('object');
    
    expect(body.data).to.have.property('begindatum');
    expect(body.data).to.have.property('beloning');
    expect(body.data).to.have.property('beperking_categorie');
    expect(body.data).to.have.property('beschikbaar');
    expect(body.data).to.have.property('beschrijving');
    expect(body.data).to.have.property('einddatum');
    expect(body.data).to.have.property('leeftijd_doelgroep_tot');
    expect(body.data).to.have.property('leeftijd_doelgroep_van');
    expect(body.data).to.have.property('locatie');
    expect(body.data).to.have.property('met_beloning');
    expect(body.data).to.have.property('onderzoek_id');
    expect(body.data).to.have.property('onderzoek_type');
    expect(body.data).to.have.property('organisatie_id');
    expect(body.data).to.have.property('status');
    expect(body.data).to.have.property('titel');
  });
  
}
