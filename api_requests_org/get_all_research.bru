meta {
  name: get_all_research
  type: http
  seq: 4
}

get {
  url: http://127.0.0.1:5000/api/researches/
  body: none
  auth: none
}

tests {
  test("should return status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("should return JSON object with correct keys", function() {
    const body = res.getBody();
    
    expect(body).to.be.an('object');
    expect(body).to.have.all.keys('current_page', 'data', 'message', 'success', 'total_pages', 'total_records');
  });
  
  test("should have success set to true", function() {
    const body = res.getBody();
    
    expect(body.success).to.be.true;
  });
  
  test("should have message 'Onderzoeken gevonden'", function() {
    const body = res.getBody();
    
    expect(body.message).to.equal("Onderzoeken gevonden");
  });
  
  test("should return data as a non-empty array", function() {
    const body = res.getBody();
  
    expect(body.data).to.be.an('array');
    expect(body.data.length).to.be.above(0);
  });
  
}
